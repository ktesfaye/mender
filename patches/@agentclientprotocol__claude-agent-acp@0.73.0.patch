+const wholeTranscript = {
+    async load({ projectKey, sessionId }) {
+        const root = path.join(CLAUDE_CONFIG_DIR, "projects");
+        const name = `${sessionId}.jsonl`;
+        let file = path.join(root, projectKey, name);
+        if (!existsSync(file)) {
+            const dirs = await fs.readdir(root).catch(() => []);
+            const found = dirs.map((dir) => path.join(root, dir, name)).find((one) => existsSync(one));
