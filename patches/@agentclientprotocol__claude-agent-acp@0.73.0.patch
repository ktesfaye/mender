+const wholeTranscript = {
+    async load({ projectKey, sessionId }) {
+        const root = path.join(CLAUDE_CONFIG_DIR, "projects");
+        const name = `${sessionId}.jsonl`;
+        let file = path.join(root, projectKey, name);
+        if (!existsSync(file)) {
+            const dirs = await fs.readdir(root).catch(() => []);
+            const found = dirs.map((dir) => path.join(root, dir, name)).find((one) => existsSync(one));
+            if (!found)
+                return null;
+            file = found;
+        }
+        const entries = [];
+        for (const line of (await fs.readFile(file, "utf8")).split("\n")) {
+            if (!line.trim())
+                continue;
+            try {
+                const entry = JSON.parse(line);
+                // What a compaction kept is already there before it, in the
+                // order it happened, so it is not moved up after the summary.
+                if (entry?.type === "system" && entry.subtype === "compact_boundary" && !entry.parentUuid && entry.logicalParentUuid) {
+                    entry.parentUuid = entry.logicalParentUuid;
+                    if (entry.compactMetadata) {
+                        const { preservedMessages, preservedSegment, ...rest } = entry.compactMetadata;
+                        entry.compactMetadata = rest;
+                    }
+                }
+                entries.push(entry);
+            }
+            catch { }
+        }
+        return entries;
+    },
+    async append() { },
