+// Mender: a skill or prompt command someone typed ("/brain do this") is written
+// down as marker tags that open with <command-message>, and stripping them left
+// nothing, so on replay the prompt vanished and its answer joined the turn
+// before. Read back, it is what was typed. Built-in commands (/model) open
+// with <command-name> and start no turn, so they still strip away.
+function slashAsTyped(content) {
+    const typed = (text) => {
+        if (!text.trimStart().startsWith("<command-message>"))
+            return text;
+        const name = /<command-name>([\s\S]*?)<\/command-name>/.exec(text)?.[1]?.trim();
+        if (!name)
+            return text;
+        const args = /<command-args>([\s\S]*?)<\/command-args>/.exec(text)?.[1]?.trim() ?? "";
+        const slash = name.startsWith("/") ? name : `/${name}`;
+        return args ? `${slash} ${args}` : slash;
+    };
+    if (typeof content === "string")
+        return typed(content);
+    if (!Array.isArray(content))
+        return content;
+    return content.map((block) => block && typeof block === "object" && block.type === "text" && typeof block.text === "string"
+        ? { ...block, text: typed(block.text) }
+        : block);
+}
