{
  "name": "@mender/village",
  "version": "0.0.1",
  "private": true,
  "description": "The pixel village: its world, its states, and the shore pass that draws a coast round them",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "@typescript/native-preview": "7.0.0-dev.20260609.1"
  }
}
