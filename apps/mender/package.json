{
  "name": "@emdash/mender",
  "version": "0.40.0",
  "private": true,
  "description": "Mender — an agentic coding environment that is a village",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "check:bridge": "tsx tooling/bridge-parity.mts",
    "dev": "node ../../tooling/scripts/ensure-packages-built.mjs && LOG_LEVEL=debug electron-vite dev",
    "yard": "vite --config tooling/yard.config.mjs",
    "build": "electron-vite build",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "package": "pnpm --filter @emdash/plugins run build && pnpm run build && electron-builder --mac --config electron-builder.config.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@emdash/core": "workspace:*",
    "@emdash/plugins": "workspace:*",
    "@emdash/shared": "workspace:*",
    "@emdash/wire": "workspace:*",
    "@mender/village": "workspace:*",
    "@parcel/watcher": "^2.5.6",
    "@xterm/xterm": "^6.0.0",
    "beautiful-mermaid": "^1.1.3",
    "better-sqlite3": "^12.6.0",
    "drizzle-orm": "^0.32.1",
    "node-pty": "1.1.0",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.6.6",
    "smol-toml": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "electron": "40.10.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.2",
    "vite": "^6.4.1"
  }
}
