<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Not sandboxed: the whole app is a thing that runs other people's
       compilers in other people's folders, and a sandbox is the opposite of
       that. -->
  <key>com.apple.security.app-sandbox</key><false/>
  <!-- The native bits: sqlite, the pty, the file watcher. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.get-task-allow</key><false/>
</dict>
</plist>
